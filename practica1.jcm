mas practica1 {

    /*agent bob: sample_agent.asl {
      focus: w.c1
    }*/
      
    agent mario: personal_assistant.asl {
      beliefs: preference(22)
      focus w.vm
    }

    agent luigi: personal_assistant.asl {
      beliefs: preference(23)
      focus w.vm
    }

    agent bowser: personal_assistant.asl {
      beliefs: preference(28)
      focus w.vm
    }

    agent rc: room_controller.asl {
      focus: w.hvac, w.vm
      goals: voting([18, 21, 27], 1000)
      //beliefs: preference(25)
    }

    workspace w {
      artifact c1: example.Counter(3)
      artifact hvac: devices.HVAC(30)
      artifact vm: voting.VotingMachine([mario, luigi, bowser], 1000)
    }

    organisation o: org.xml {
      group g1 : group1 {
        //players: bob role1
      }
    }

    

}
